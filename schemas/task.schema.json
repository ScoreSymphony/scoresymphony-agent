{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.dev/schemas/agent/task.schema.json",
  "title": "ScoreSymphony Agent Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "title", "status", "risk", "scope", "acceptance_criteria", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^SCORESYMPHONY-TASK-[A-F0-9]{12}$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {"enum": ["pending", "running", "blocked", "completed", "cancelled"]},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "scope": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
