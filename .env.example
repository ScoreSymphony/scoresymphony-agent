# Local/staging defaults
SCORESYMPHONY_AGENT_PORT=8080
SCORESYMPHONY_ENV=development
SCORESYMPHONY_STATE_ROOT=./state-local
SCORESYMPHONY_AUTH_MODE=development

# Production contract (do not commit the real secret):
# SCORESYMPHONY_ENV=production
# SCORESYMPHONY_STATE_ROOT=/var/lib/scoresymphony-agent
# SCORESYMPHONY_AUTH_MODE=forward_auth
# SCORESYMPHONY_PROXY_SECRET=<injected secret>
# SCORESYMPHONY_OWNER_GROUP=scoresymphony-owner
# SCORESYMPHONY_ADMIN_GROUP=scoresymphony-admin
